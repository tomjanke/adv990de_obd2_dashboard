<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Das Theme der App. Sein Fensterhintergrund ist zugleich die Flaeche des System-Splash (Android 12+ nimmt
         windowBackground, wenn es eine einzelne Farbe ist) und das, was Android < 12 vor dem ersten Frame zeigt. -->
    <style name="Theme.OBD2Monitor" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background_system</item>
    </style>

    <!-- Splash-Themes je gewaehltem Farbschema: die App setzt eines per SplashScreen.setSplashScreenTheme fuer den NAECHSTEN
         Start (ui/theme/SplashTheme.kt). Das System persistiert die NAMEN — nie umbenennen (SplashThemeTest). -->
    <style name="Theme.OBD2Monitor.Splash.Light" parent="Theme.OBD2Monitor">
        <item name="android:windowBackground">@color/splash_background_light</item>
    </style>
    <style name="Theme.OBD2Monitor.Splash.Dark" parent="Theme.OBD2Monitor">
        <item name="android:windowBackground">@color/splash_background_dark</item>
    </style>
    <style name="Theme.OBD2Monitor.Splash.Blue" parent="Theme.OBD2Monitor">
        <item name="android:windowBackground">@color/splash_background_blue</item>
    </style>
    <style name="Theme.OBD2Monitor.Splash.Amber" parent="Theme.OBD2Monitor">
        <item name="android:windowBackground">@color/splash_background_amber</item>
    </style>
    <style name="Theme.OBD2Monitor.Splash.Green" parent="Theme.OBD2Monitor">
        <item name="android:windowBackground">@color/splash_background_green</item>
    </style>
</resources>
